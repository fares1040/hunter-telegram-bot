# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# OpenAI (optional — for catalyst reasoning)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Polygon (optional — enables real-time market data + options)
POLYGON_API_KEY=

# Finnhub (optional — enables news gathering)
FINNHUB_API_KEY=

# Scoring thresholds
HUNTER_MIN_SCORE=70
HUNTER_MIN_DATA_CONFIDENCE=60
MAX_WATCHLIST_PRICE=100.0

# Risk management
ACCOUNT_SIZE=
RISK_PER_TRADE_PCT=0.5

# Options
OPTIONS_ENABLED=true

# Scheduler (seconds between full watchlist passes per session)
SCAN_INTERVAL_REGULAR=300
SCAN_INTERVAL_EXTENDED=900
SCAN_INTERVAL_CLOSED=1800

# Interactive commands (/scan /add /remove /watchlist /status /stats /discover)
TELEGRAM_COMMANDS_ENABLED=true
# Extra authorized chat IDs (comma-separated); alert chat is always authorized
TELEGRAM_AUTHORIZED_CHAT_ID=

# Market discovery (Phase 2.5)
DISCOVERY_ENABLED=true
DISCOVERY_POOL_SIZE=10
DISCOVERY_CACHE_TTL=180
DISCOVERY_MIN_ABS_CHANGE=3.0
DISCOVERY_MAX_CANDIDATES_PER_SOURCE=25

# Stage 2 — Real-Time Intelligence (safe defaults: disabled unless explicitly enabled)
REALTIME_ENABLED=false
REALTIME_MAX_AGE_SECONDS=30
POLYGON_WS_ENABLED=false
OPTIONS_FLOW_REALTIME_ENABLED=false
OPTIONS_FLOW_REALTIME_MAX_AGE_SECONDS=30

# Misc
MARKET_TIMEZONE=America/New_York
LOG_LEVEL=INFO
MEMORY_DB_PATH=data/hunter_memory.sqlite3
