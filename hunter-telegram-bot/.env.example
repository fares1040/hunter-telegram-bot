# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# OpenAI (optional — for catalyst reasoning)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Polygon (optional — enables real-time market data + options)
POLYGON_API_KEY=

# Finnhub (optional — enables news gathering)
FINNHUB_API_KEY=

# Scoring thresholds
HUNTER_MIN_SCORE=70
HUNTER_MIN_DATA_CONFIDENCE=60
MAX_WATCHLIST_PRICE=100.0

# Risk management
ACCOUNT_SIZE=
RISK_PER_TRADE_PCT=0.5

# Options
OPTIONS_ENABLED=true

# Misc
MARKET_TIMEZONE=America/New_York
LOG_LEVEL=INFO
MEMORY_DB_PATH=data/hunter_memory.sqlite3
